# Databases and cache
DATABASE_URL_MAIN=postgres://wfh:wfh@localhost:5432/wfh_main
DATABASE_URL_LOG=postgres://wfh:wfh@localhost:5433/wfh_log
REDIS_URL=redis://localhost:6379

# Object storage (MinIO)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wfh

# Streaming (Redpanda)
REDPANDA_BROKERS=localhost:9092

# Realtime (Centrifugo)
CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=change-me

# Application secrets
SESSION_SECRET=change-me

# Internal service-to-service calls
# Auth token sent as X-Internal-Token by identity-service to the attendance
# internal endpoint; must match between identity and attendance.
INTERNAL_API_TOKEN=local-internal-token-2026
# URL used by identity-service to reach the attendance internal endpoint.
ATTENDANCE_INTERNAL_URL=http://attendance-service:3002

# Service ports
PORT_IDENTITY=3001
PORT_ATTENDANCE=3002
PORT_NOTIFICATION=3003

# First-deploy HR bootstrap (one-shot `bootstrap-seeder` compose service).
# Indexed, contiguous BOOTSTRAP_HR_<n>_* groups; consulted only when the main
# database has zero role='hrd' rows. Real deployments must override these —
# never commit production passwords. Empty groups are ignored by compose.
BOOTSTRAP_HR_1_EMAIL=first.hr@company.com
BOOTSTRAP_HR_1_NAME=First HR
BOOTSTRAP_HR_1_POSITION=HR Manager
BOOTSTRAP_HR_1_PHONE=+62-811-0000-0101
BOOTSTRAP_HR_1_INITIAL_PASSWORD=ChangeMeFirst!2026
BOOTSTRAP_HR_2_EMAIL=second.hr@company.com
BOOTSTRAP_HR_2_NAME=Second HR
BOOTSTRAP_HR_2_POSITION=HR Staff
BOOTSTRAP_HR_2_PHONE=+62-811-0000-0102
BOOTSTRAP_HR_2_INITIAL_PASSWORD=ChangeMeSecond!2026
