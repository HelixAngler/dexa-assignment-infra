{
  "name": "infra",
  "version": "0.1.0",
  "private": true,
  "description": "Edge routing, compose stack, CI, e2e/load/security suites for the monorepo.",
  "scripts": {
    "lint": "eslint --config tooling/eslint.config.js tooling e2e scripts load",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:smoke": "playwright test --config e2e/playwright.config.ts browser-absen-smoke",
    "test": "npm run typecheck",
    "i18n": "node --experimental-strip-types scripts/check-i18n-keys.ts",
    "db:generate": "prisma generate --schema prisma/main/schema.prisma && prisma generate --schema prisma/log/schema.prisma",
    "db:migrate": "bash scripts/migrate.sh",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "design:coverage": "node --experimental-strip-types scripts/design-coverage.ts",
    "design:tokens-check": "node --experimental-strip-types scripts/design-tokens-check.ts",
    "design:contrast": "playwright test --config design-qa/playwright.config.ts contrast",
    "design:layout": "playwright test --config design-qa/playwright.config.ts layout"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9",
    "@playwright/test": "^1.48",
    "@types/node": "^22",
    "eslint": "^9",
    "prettier": "^3",
    "prisma": "^6.12.0",
    "typescript": "^5.6",
    "typescript-eslint": "^8"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "argon2": "^0.45.1"
  }
}
